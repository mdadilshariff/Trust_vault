# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trustvault:changeme@localhost:5432/trustvault
SYNC_DATABASE_URL=postgresql://trustvault:changeme@localhost:5432/trustvault

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-64-random-bytes-in-hex
SESSION_COOKIE_NAME=tv_session
SESSION_MAX_AGE_SECONDS=3600

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=52428800
ALLOWED_EXTENSIONS=pdf,docx,doc,xlsx,xls,pptx,ppt,txt,png,jpg,jpeg,gif,zip,csv,md

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Postgres (Docker Compose) ─────────────────────────────────────────────────
POSTGRES_USER=trustvault
POSTGRES_PASSWORD=changeme
POSTGRES_DB=trustvault
