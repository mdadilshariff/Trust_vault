# =============================================================================
# TrustVault - Supabase & Production Environment Configuration
# =============================================================================

# 1. Supabase PostgreSQL Connection
# Copy from Supabase Dashboard -> Project Settings -> Database -> Connection String
# Use URI mode (Session pooler on port 5432 or Transaction pooler on port 6543)
# Note: You can paste either 'postgresql://' or 'postgresql+asyncpg://', both are handled automatically.
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
SYNC_DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# 2. Session & Security
SECRET_KEY=generate-a-strong-64-character-hex-secret-key-here
SESSION_COOKIE_NAME=tv_session
SESSION_MAX_AGE_SECONDS=86400

# 3. File Storage
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_BYTES=52428800
ALLOWED_EXTENSIONS=pdf,docx,doc,xlsx,xls,pptx,ppt,txt,png,jpg,jpeg,gif,zip,csv,md

# 4. CORS Origins (Include your Vercel domain and local preview domains)
CORS_ORIGINS=https://[YOUR-VERCEL-APP].vercel.app,http://localhost:5173,http://localhost:4173

# 5. Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
